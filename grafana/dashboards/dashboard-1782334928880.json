                        "rawQuery": true,
                        "rawSql": "WITH latest_drift AS (SELECT * FROM drift_statistics ORDER BY check_date DESC LIMIT 1),\r\nlatest_baseline AS (SELECT * FROM training_statistics ORDER BY training_date DESC LIMIT 1)\r\nSELECT\r\n  ROUND(CAST(ABS(d.solar_production_mean - b.solar_production_mean) / NULLIF(b.solar_production_mean, 0) * 100 AS numeric), 2) AS \"Solar (%)\",\r\n  ROUND(CAST(ABS(d.wind_production_mean - b.wind_production_mean) / NULLIF(b.wind_production_mean, 0) * 100 AS numeric), 2)   AS \"Wind (%)\",\r\n  ROUND(CAST(ABS(d.mixed_production_mean - b.mixed_production_mean) / NULLIF(b.mixed_production_mean, 0) * 100 AS numeric), 2) AS \"Mixed (%)\"\r\n  \r\nFROM latest_drift d, latest_baseline b;\r\n",
